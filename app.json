{
  "expo": {
    "name": "Fiyat Gör",
    "slug": "fiyatgor-mobile",
    "version": "1.1.0",
    "icon": "./assets/images/icon.png",
    "scheme": "fiyatgormobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "bundleIdentifier": "com.panuteknoloji.fiyatgor",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Panu Fiyat Gör, ürün barkodlarını ve QR kodlarını tarayarak fiyat bilgilerini göstermek için kamerayı kullanır.",
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSLocationWhenInUseUsageDescription": "Konum bilgisi aktif olarak kullanılmamaktadır, ancak üçüncü taraf kütüphaneler tarafından gerekli görülebilir."
      },
      "bundleIdentifier": "com.panuteknoloji.fiyatgor",
      "appleTeamId": "T6JL5WN5L2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "android.permission.CAMERA"],
      "package": "com.panu.fiyatgor"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "react-native-vision-camera",
        {
          "enableCodeScanner": true,
          "cameraPermissionText": "Panu Fiyat Gör, ürün barkodlarını ve QR kodlarını tarayarak fiyat bilgilerini göstermek için kamerayı kullanır."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b47d08e9-8e1d-4ad1-91af-c11a8f4f90c1"
      }
    }
  }
}
